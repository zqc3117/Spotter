#!/usr/bin/env bash
# Copy to env.sh, edit the paths, and `source` it before starting anything.
#
#   source env/env.sh
#
# Nothing in the repository reads env.sh by name; sourcing it just puts these
# variables in your shell. Every one of them has a default, so you only need to
# set the ones that differ on your machine.

# ---------------------------------------------------------------------------
# 1. This repository
# ---------------------------------------------------------------------------
# All the scripts derive the repository root from their own location, so you
# normally do not need this. Set it when a script has been copied out of the
# tree.
# export JUDGE_REPO_ROOT=/path/to/Spotter

# ---------------------------------------------------------------------------
# 2. Simulator + Cosmos policy runtime (Python 3.10)
# ---------------------------------------------------------------------------
# COSMOS_POLICY_ROOT is the upstream cosmos-policy tree. It supplies three
# things this repository does not contain: the `robocasa` package, the
# `cosmos_policy` package, and `python -m rpc.server` (the Cosmos policy
# server, which is *not* this repository's rpc/).
export COSMOS_POLICY_ROOT=${COSMOS_POLICY_ROOT:-/path/to/cosmos_policy}
export COSMOS_POLICY_SRC="$COSMOS_POLICY_ROOT/src/cosmos-policy"
export ROBOCASA_SRC="$COSMOS_POLICY_ROOT/src/robocasa-cosmos-policy"
export COSMOS_POLICY_ENV="$COSMOS_POLICY_ROOT/envs/robocasa"   # the Python 3.10 venv

# Headless rendering. MuJoCo renders through EGL; without these it will try GLX
# and fail on a machine with no display.
export MUJOCO_GL=${MUJOCO_GL:-egl}
export PYOPENGL_PLATFORM=${PYOPENGL_PLATFORM:-egl}

# MuJoCo also needs libEGL.so.1 itself. A lot of CUDA images ship the NVIDIA EGL
# vendor file but not the library, and the failure is unhelpful:
#   AttributeError: 'NoneType' object has no attribute 'eglQueryString'
# The upstream cosmos-policy tree carries a portable copy; use it only when the
# system has none, so this is a no-op on an image that is already complete.
_portable_egl="$COSMOS_POLICY_ROOT/system_deps/ubuntu22.04-amd64/usr/lib/x86_64-linux-gnu"
if [ ! -e /usr/lib/x86_64-linux-gnu/libEGL.so.1 ] && [ -e "$_portable_egl/libEGL.so.1" ]; then
  export LD_LIBRARY_PATH="$_portable_egl:${LD_LIBRARY_PATH:-}"
fi
unset _portable_egl

# Everything loads from disk; nothing is fetched at run time.
export HF_HUB_OFFLINE=${HF_HUB_OFFLINE:-1}
export TRANSFORMERS_OFFLINE=${TRANSFORMERS_OFFLINE:-1}

# ---------------------------------------------------------------------------
# 3. Policy checkpoints
# ---------------------------------------------------------------------------
export COSMOS_CHECKPOINT=${COSMOS_CHECKPOINT:-$COSMOS_POLICY_ROOT/artifacts/checkpoints/Cosmos-Policy-RoboCasa-Predict2-2B/Cosmos-Policy-RoboCasa-Predict2-2B.pt}
export PI05_CHECKPOINT=${PI05_CHECKPOINT:-$COSMOS_POLICY_ROOT/artifacts/checkpoints/pi05-robocasa-H50}

# ---------------------------------------------------------------------------
# 4. pi0.5 policy server runtime (Python 3.12, lerobot)
# ---------------------------------------------------------------------------
# A second venv, because lerobot needs a newer stack than the simulator does.
export PI05_PYTHON=${PI05_PYTHON:-/path/to/pi05-venv/bin/python}

# ---------------------------------------------------------------------------
# 5. Judge and screener (vLLM serving Qwen3.8-27B-FP8)
# ---------------------------------------------------------------------------
# The host serving the model. 127.0.0.1 when it runs on the same machine as the
# judge driver; otherwise the address of the machine that serves it.
export SCREENER_HOST=${SCREENER_HOST:-127.0.0.1}
# Only when the judge and the screener are served from different hosts. Note that
# cli/qwen_call.py falls back to SCREENER_HOST by itself, but your shell does not:
# a command that spells $QWEN_HOST while this stays commented out builds a URL like
# http://:8301/ and fails with a parse error instead of saying what is wrong.
# export QWEN_HOST="$SCREENER_HOST"
# export QWEN_PORTS=8301,8302,8303,8304      # one port per replica
export QWEN_MODEL=${QWEN_MODEL:-/path/to/Qwen3.8-27B-FP8}   # served with `vllm serve`, see README.md
# export VLLM_VENV=/path/to/vllm-venv        # the venv that has vllm installed

# The judge keeps a long multimodal conversation. The default of 3 silently
# strips images and truncates earlier turns; see README.md.
export QWEN_KEEP_TURNS=${QWEN_KEEP_TURNS:-20}

# The screener module ships in recovery_explore/cli/. Set this only if you keep
# it somewhere else.
# export SCREENER_DIR=/path/to/dir/containing/screener.py

# Optional. While the screener is calling vLLM it drops a lease file in this
# directory, so another process sharing the GPU can watch it and step aside.
# Leave it unset unless you run such a process.
# export VLLM_LEASE_DIR=/shared/volume/.holder_lease

# ---------------------------------------------------------------------------
# 6. GPT-6 judge (--engine api). Billed per call.
# ---------------------------------------------------------------------------
# cli/gpt6_call.py talks to api.openai.com with /etc/openai_api_token unless
# BOTH of these are set. Ping the endpoint once before starting a run.
# export OPENAI_RESPONSES_URL="https://<relay>/v1/responses"
# export OPENAI_API_TOKEN_FILE="/path/to/key"
